# StyleSenseAI — Environment Configuration
# Copy to .env and fill in values. NEVER commit .env!

# === Application ===
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING
APP_HOST=0.0.0.0
APP_PORT=8000

# === Database ===
DATABASE_URL=postgresql+asyncpg://stylesense:stylesense_dev@localhost:5432/stylesense
DATABASE_ECHO=false

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === Auth ===
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# === Encryption ===
MASTER_ENCRYPTION_KEY=CHANGE_ME_TO_A_BASE64_ENCODED_32_BYTE_KEY

# === Provider Selection ===
LLM_PROVIDER=mock
CLASSIFIER_PROVIDER=local
EMBEDDING_PROVIDER=mock
SUGGESTION_PROVIDER=local
STORAGE_PROVIDER=localfs
JOBS_EAGER=true

# === S3 / MinIO ===
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=stylesense
S3_REGION=us-east-1

# === LocalFS Storage (for tests/dev) ===
LOCAL_STORAGE_PATH=./storage

# === Anthropic (optional, only when LLM_PROVIDER=claude) ===
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# === Live Search (optional, only when SUGGESTION_PROVIDER=live or auto) ===
SEARCH_API_KEY=
SEARCH_API_BASE_URL=

# === ClamAV (optional) ===
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_ENABLED=false

# === Rate Limiting ===
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_UPLOAD_PER_MINUTE=10
RATE_LIMIT_LLM_PER_MINUTE=20

# === CORS ===
CORS_ORIGINS=["http://localhost:3000"]

# === Logging ===
LOG_LEVEL=INFO
LOG_FORMAT=json
